{
	// Base markdownlint configuration passed to every markdownlint-cli2 run
	// via --config. A project's own .markdownlint-cli2.jsonc (or any other
	// config file markdownlint-cli2 discovers) layers on top and wins, so this
	// only decides what a project that has declared nothing gets.
	//
	// NOTE: this is the markdownlint-cli2 OPTIONS shape (rules nested under
	// "config"), not a bare rules object. markdownlint-cli2 chooses which of
	// the two to expect from the config FILENAME, so this only parses
	// correctly while it is materialized as *.markdownlint-cli2.jsonc -- see
	// userMarkdownlintConfigFile in markdownconfig.go. A mismatch is silent:
	// the file is discarded and stock rules apply, with no error to explain
	// why. markdownconfig_test.go pins both halves.
	//
	// The rules disabled below are the ones that are both commonly violated on
	// purpose in technical writing and not auto-fixable. Because the hook
	// surfaces any non-zero exit as a diagnostic, leaving one of those enabled
	// turns every .md write into noise it cannot act on.
	"config": {
		"default": true,

		// MD013 (line-length) fires on any long URL, table row, or code sample
		// and cannot be auto-fixed -- wrapping is a judgement call about
		// readability, not a mechanical transform.
		"MD013": false,

		// MD041 (first-line-heading) assumes every file is a whole document.
		// GitHub issue and pull-request templates are fragments that open on a
		// "## Section" by convention, as are includes and partials, and no
		// mechanical fix exists -- inserting an h1 would change what the file
		// renders as.
		"MD041": false,

		// MD024 (no-duplicate-heading) flags the repeated "Added"/"Changed"/
		// "Fixed" headings that every Keep a Changelog file has by
		// construction, once per release. siblings_only narrows it to
		// duplicates under the SAME parent, which keeps the real error (two
		// identical sections in one release) while accepting the format.
		"MD024": { "siblings_only": true },

		// MD033 (no-inline-html) forbids raw HTML outright. Centered title
		// banners at the top of a README are deliberate and widespread, so the
		// elements that show up in that pattern are allowed rather than the rule
		// being switched off entirely.
		"MD033": {
			"allowed_elements": [
				"h1",
				"div",
				"p",
				"img",
				"a",
				"br",
				"details",
				"summary"
			]
		},
		"MD060": { "style": "compact" }
	},
	// Only reached when markdownlint-cli2 is pointed at a glob -- the hook
	// always hands it one already-filtered absolute path. Kept because this
	// file is materialized into ~/.claude for operators to run directly.
	// vendoredDirs in internal/dispatch/dispatch.go owns this list; mirror it
	// there, not here.
	"ignores": [
		"**/node_modules",
		"**/.next",
		"**/.yarn",
		"**/.git",
		"**/.agents",
		"**/.orchestrate",
		"**/.playwright-mcp",
		"**/dist",
		"**/build",
		"**/target",
		"**/coverage",
		"**/test-results",
		"**/vendor",
		"**/.venv",
		"**/.terraform",
		"**/__pycache__",
		"**/.ruff_cache",
		"**/.mypy_cache",
		"**/.pytest_cache",
		"**/.tox"
	]
}
